root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props}]
indent_size = 2

# Nombres con guion bajo permitidos en tests (Metodo_condicion_resultado)
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
